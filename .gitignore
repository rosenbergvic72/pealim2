@"
# dependencies
node_modules/

# Expo / RN
.expo/
.expo-shared/
dist/
web-build/
coverage/
build/
tmp/
temp/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.iml

# Metro
.metro-health-check*

# Native (Android)
android/.gradle/
android/.cxx/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/key.properties
android/app/**/*.keystore
android/app/**/*.jks
pepk.jar
pepk_out.zip

# Native (iOS)
ios/build/
ios/DerivedData/
ios/Pods/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/*.xcworkspace/xcuserdata/

# Certificates / keys
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Local env
.env*.local
.env

# TypeScript
*.tsbuildinfo

# Firebase/Play configs (обычно коммитят; раскомментируй при желании скрыть)
# android/app/google-services.json
# GoogleService-Info.plist

# Секреты
service-account*.json

# Сервер внутри проекта (если держишь его тут)
iap-server/

# allow iap server entrypoint
!iap-server/
!iap-server/server.js

# Montserrat — по умолчанию игнорируем всё
assets/fonts/Montserrat-*.ttf

# Но разрешаем реально используемые
!assets/fonts/Montserrat-Regular.ttf
!assets/fonts/Montserrat-Bold.ttf

# local backup copies
* copy.js
* copy*.js
* copy*.jsx
* copy *.jsx
* copy *.js
