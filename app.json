{
  "expo": {
    "name": "Verbify",
    "slug": "pealim2",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/iconjjj.png",
    "splash": {
      "image": "./assets/images/icon512.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d4769"
    },
    "extra": {
      "eas": {
        "projectId": "1c3fbe10-9608-4dd7-a477-f0ae7c294b5e"
      },
      "IS_TEST_BUILD": "false"
    },
    "android": {
      "package": "com.rosenbergvictor72.pealim2",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 2000099,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/iconjjj.png",
        "backgroundColor": "#2d4769"
      },
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.rosenbergvictor72.pealim2",
      "buildNumber": "64",
      "icon": "./assets/images/icon1024.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Verbify may access your photo library only when required by system components used by the app. Verbify does not use your photos for advertising or tracking."
      }
    },
    "plugins": [
      "expo-localization",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2d4769"
        }
      ]
    ]
  }
}
